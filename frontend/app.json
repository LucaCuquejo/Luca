{
  "expo": {
    "name": "InnerBrother",
    "slug": "innerbrother",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B2A4A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.innerbrother",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for profile photo",
        "NSMicrophoneUsageDescription": "Used for voice messages",
        "NSContactsUsageDescription": "Used to select emergency contacts"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B2A4A"
      },
      "package": "app.innerbrother",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "CALL_PHONE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
